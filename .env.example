# Database Configuration (SQLite)
DB_PATH=temple.db

# LLM API Configuration
# Google Gemini: 填入 Google AI Studio 的 API Key (https://aistudio.google.com/)
# OpenAI: 填入 OpenAI Platform 的 API Key (https://platform.openai.com/)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gemini-3.1-flash-lite-preview

# Optional: 自訂 API 端點 (預設會自動偵測 Gemini/OpenAI)
# 自架 Ollama: OPENAI_BASE_URL=http://localhost:11434/v1
# Azure OpenAI: OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# 其他相容 OpenAI 格式的 API: OPENAI_BASE_URL=https://your-custom-endpoint.com/v1
# OPENAI_BASE_URL=

# Admin Password (建議上線前更改為強密碼)
ADMIN_PASSWORD=temple888
