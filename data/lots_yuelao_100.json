[
  {
    "lot_type": "yuelao_100",
    "lot_number": 1,
    "lot_name": "第一籤",
    "grade": "",
    "content": "關關雎鳩，在河之洲，\n窈窕淑女，君子好逑。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 2,
    "lot_name": "第二籤",
    "grade": "",
    "content": "落霞與孤鶩齊飛，\n秋水共長天一色。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 3,
    "lot_name": "第三籤",
    "grade": "",
    "content": "宗廟享之，\n子孫保人。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 4,
    "lot_name": "第四籤",
    "grade": "",
    "content": "斯人也而有斯疾也，\n斯人也而有斯疾也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 5,
    "lot_name": "第五籤",
    "grade": "",
    "content": "踰東家牆而摟其處子，摟之。\n則得妻；不摟，則不得妻。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 6,
    "lot_name": "第六籤",
    "grade": "",
    "content": "風弄竹聲，只道金珮響；\n月移花影，疑是玉人來。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 7,
    "lot_name": "第七籤",
    "grade": "",
    "content": "斯是陋室，\n惟我德馨。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 8,
    "lot_name": "第八籤",
    "grade": "",
    "content": "期我乎桑中，\n要我乎上宮，\n送我乎淇之上矣。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 9,
    "lot_name": "第九籤",
    "grade": "",
    "content": "則父母國人皆賤之。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 10,
    "lot_name": "第十籤",
    "grade": "",
    "content": "又道是養兒防老，積穀防飢。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 11,
    "lot_name": "第十一籤",
    "grade": "",
    "content": "<span style=\"font-size:14px;\">自剪芭蕉寫佛經 金蓮無複印中庭，\n清風明月長相憶 玉管朱弦可要聽，\n多病不勝衣更薄 宿粧猶在酒初醒，\n隔年違別成何事 臥看牽牛織女星。</span>",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 12,
    "lot_name": "第十二籤",
    "grade": "",
    "content": "一則以喜，\n一則以懼。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 13,
    "lot_name": "第十三籤",
    "grade": "",
    "content": "有宗室之美。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 14,
    "lot_name": "第十四籤",
    "grade": "",
    "content": "誰謂荼苦？其甘如薺。\n燕爾新婚，如兄如弟。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 15,
    "lot_name": "第十五籤",
    "grade": "",
    "content": "君子審禮，不可誣以訐詐。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 16,
    "lot_name": "第十六籤",
    "grade": "",
    "content": "意中人，人中意，\n只那些無情花鳥也情痴。\n一般的解語，雙頭學並棲。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 17,
    "lot_name": "第十七籤",
    "grade": "",
    "content": "德者本也，\n財者末也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 18,
    "lot_name": "第十八籤",
    "grade": "",
    "content": "非獨內德茂也，\n蓋亦以外感之助焉。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 19,
    "lot_name": "第十九籤",
    "grade": "",
    "content": "或十年，或七八年，\n或五六年，或三四年。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 20,
    "lot_name": "第二十籤",
    "grade": "",
    "content": "何如？子曰··可也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 21,
    "lot_name": "第二十一籤",
    "grade": "",
    "content": "十畝九間兮，\n桑者閑閑兮。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 22,
    "lot_name": "第二十二籤",
    "grade": "",
    "content": "久旱逢甘雨，他鄉遇故知；\n洞房花燭夜，金榜題名時。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 23,
    "lot_name": "第二十三籤",
    "grade": "",
    "content": "只一點故情留得，\n春蠶到死尚把絲抽。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 24,
    "lot_name": "第二十四籤",
    "grade": "",
    "content": "因荷而得藕，\n有杏不湏梅。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 25,
    "lot_name": "第二十五籤",
    "grade": "",
    "content": "可妻也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 26,
    "lot_name": "第二十六籤",
    "grade": "",
    "content": "維熊維羆，男子之祥；\n維虺維蛇，女子之祥。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 27,
    "lot_name": "第二十七籤",
    "grade": "",
    "content": "有意栽花花不發，\n無心插柳柳成蔭。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 28,
    "lot_name": "第二十八籤",
    "grade": "",
    "content": "夫婦也，\n昆弟也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 29,
    "lot_name": "第二十九籤",
    "grade": "",
    "content": "山窮水盡疑無路，\n柳暗花明又一村。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 30,
    "lot_name": "第三十籤",
    "grade": "",
    "content": "話別無長夜，相思又此春。\n瑤姬不可見，巫峽更何人。\n運石疑填海，乘槎欲問津。\n遙情每未注，誰共爾為鄰？",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 31,
    "lot_name": "第三十一籤",
    "grade": "",
    "content": "踏破鐵鞋無覓處，\n得來全不費功夫。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 32,
    "lot_name": "第三十二籤",
    "grade": "",
    "content": "可以托六尺之孤，\n可以寄百里之命。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 33,
    "lot_name": "第三十三籤",
    "grade": "",
    "content": "仍舊貫，如之何？\n何必改作？",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 34,
    "lot_name": "第三十四籤",
    "grade": "",
    "content": "遇人之不淑矣。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 35,
    "lot_name": "第三十五籤",
    "grade": "",
    "content": "設虛，夜靜水寒，魚不餌，\n笑滿船空載明月。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 36,
    "lot_name": "第三十六籤",
    "grade": "",
    "content": "求則得之，\n捨則失之。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 37,
    "lot_name": "第三十七籤",
    "grade": "",
    "content": "妻焉者，親之主也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 38,
    "lot_name": "第三十八籤",
    "grade": "",
    "content": "不得乎親，不可以為人。\n不順乎親，不可以為子。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 39,
    "lot_name": "第三十九籤",
    "grade": "",
    "content": "帷舊婚媾，\n其能降以相從乎？",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 40,
    "lot_name": "第四十籤",
    "grade": "",
    "content": "良人者，所仰望必終身者也，\n今若此。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 41,
    "lot_name": "第四十一籤",
    "grade": "",
    "content": "重重疊疊上瑤台，\n幾度呼童掃不開；\n剛被太陽收拾去，\n却叫明月送將來。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 42,
    "lot_name": "第四十二籤",
    "grade": "",
    "content": "投我以木桃，\n報之以瓊瑤。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 43,
    "lot_name": "第四十三籤",
    "grade": "",
    "content": "遐邇一體，\n率賓舊王。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 44,
    "lot_name": "第四十四籤",
    "grade": "",
    "content": "後生可畏，\n焉知來者人不如今也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 45,
    "lot_name": "第四十五籤",
    "grade": "",
    "content": "不愧於天，\n不畏於人。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 46,
    "lot_name": "第四十六籤",
    "grade": "",
    "content": "害女紅者也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 47,
    "lot_name": "第四十七籤",
    "grade": "",
    "content": "五百英雄都在此，\n不知誰是狀元郎？",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 48,
    "lot_name": "第四十八籤",
    "grade": "",
    "content": "故好而知其惡，\n惡而知其美也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 49,
    "lot_name": "第四十九籤",
    "grade": "",
    "content": "兩世一身，\n形單影之。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 50,
    "lot_name": "第五十籤",
    "grade": "",
    "content": "雖有善者，\n亦無如之何矣。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 51,
    "lot_name": "第五十一籤",
    "grade": "",
    "content": "雲從龍，風從虎，\n聖人作而萬物覩。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 52,
    "lot_name": "第五十二籤",
    "grade": "",
    "content": "成也是你母親，\n敗也是你蕭何。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 53,
    "lot_name": "第五十三籤",
    "grade": "",
    "content": "不思舊姻，\n求爾新婦。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 54,
    "lot_name": "第五十四籤",
    "grade": "",
    "content": "永老無別離，萬古常團聚，\n願天下有情人都成眷屬 。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 55,
    "lot_name": "第五十五籤",
    "grade": "",
    "content": "其所厚者薄，\n其所薄者厚。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 56,
    "lot_name": "第五十六籤",
    "grade": "",
    "content": "是謂鳳凰于飛，\n和鳴鏘鏘。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 57,
    "lot_name": "第五十七籤",
    "grade": "",
    "content": "君子有援琴之桃，\n淑女無投梭之拒。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 58,
    "lot_name": "第五十八籤",
    "grade": "",
    "content": "膾炙所同好，\n羊棗所獨也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 59,
    "lot_name": "第五十九籤",
    "grade": "",
    "content": "心茍不愆，\n何惜於人言。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 60,
    "lot_name": "第六十籤",
    "grade": "",
    "content": "不知其人，\n視其友。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 61,
    "lot_name": "第六十一籤",
    "grade": "",
    "content": "嘉耦曰配。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 62,
    "lot_name": "第六十二籤",
    "grade": "",
    "content": "子規半夜猶啼血，\n不信東風喚不回。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 63,
    "lot_name": "第六十三籤",
    "grade": "",
    "content": "齊大非吾耦也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 64,
    "lot_name": "第六十四籤",
    "grade": "",
    "content": "在幽閨自憐。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 65,
    "lot_name": "第六十五籤",
    "grade": "",
    "content": "驚起却回頭，有恨無人省。\n揀盡寒枝不肯棲，\n寂寞沙洲冷。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 66,
    "lot_name": "第六十六籤",
    "grade": "",
    "content": "再，斯可矣",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 67,
    "lot_name": "第六十七籤",
    "grade": "",
    "content": "茍有可觀，皆有可樂，\n匪必瑰奇偉麗者也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 68,
    "lot_name": "第六十八籤",
    "grade": "",
    "content": "天下多負人，何必是。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 69,
    "lot_name": "第六十九籤",
    "grade": "",
    "content": "利有攸往。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 70,
    "lot_name": "第七十籤",
    "grade": "",
    "content": "雖有絲麻，無棄官蒯。\n雖有姬姜，無棄蕉萃。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 71,
    "lot_name": "第七十一籤",
    "grade": "",
    "content": "以若所為，求若所欲，\n猶緣木求魚也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 72,
    "lot_name": "第七十二籤",
    "grade": "",
    "content": "白雲初晴，幽鳥相逐。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 73,
    "lot_name": "第七十三籤",
    "grade": "",
    "content": "恨相見晚也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 74,
    "lot_name": "第七十四籤",
    "grade": "",
    "content": "則去偷香竊玉上用心，\n又不曾得甚，\n自從海棠開，\n想到如今。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 75,
    "lot_name": "第七十五籤",
    "grade": "",
    "content": "忘足，履之適也；\n忘腰，帶之適也。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 76,
    "lot_name": "第七十六籤",
    "grade": "",
    "content": "標有梅，其實七兮，\n求我庶士，迨其吉兮。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 77,
    "lot_name": "第七十七籤",
    "grade": "",
    "content": "欲速則不達。\n見小利則大事不成。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 78,
    "lot_name": "第七十八籤",
    "grade": "",
    "content": "更洒遍客舍青青，\n千縷柳色新。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 79,
    "lot_name": "第七十九籤",
    "grade": "",
    "content": "悲莫悲兮生別離，\n樂莫樂兮新相知。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 80,
    "lot_name": "第八十籤",
    "grade": "",
    "content": "經之營之，\n不日成之",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 81,
    "lot_name": "第八十一籤",
    "grade": "",
    "content": "行，前朱雀而後玄，\n左青龍而右白虎。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 82,
    "lot_name": "第八十二籤",
    "grade": "",
    "content": "姑舍是。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 83,
    "lot_name": "第八十三籤",
    "grade": "",
    "content": "勸君莫惜金縷衣，\n勸君惜取少年時，\n花開堪折直須折，\n莫待無花空折枝。",
    "story": ""
  },
  {
    "lot_type": "yuelao_100",
    "lot_number": 84,
    "lot_name": "第八十四籤",
    "grade": "",
    "content": "得其所哉，\n得其所哉。",
    "story": ""
  },
  {
